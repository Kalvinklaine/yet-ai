{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yet-ai.local/schemas/engine/project-context-rebuild-request.schema.json",
  "title": "ProjectContextRebuildRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "expectedInventoryGeneration", "expectedProjectRevision"],
  "properties": {
    "mode": { "enum": ["full", "incremental"] },
    "expectedInventoryGeneration": { "type": "integer", "minimum": 0 },
    "expectedProjectRevision": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
  }
}
